{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aurelio-nakamura/cmdxray",
  "title": "cmdxray",
  "description": "Offline MCP server: explains shell commands token-by-token and flags destructive ones for AI agents.",
  "version": "0.26.1",
  "repository": {
    "url": "https://github.com/aurelio-nakamura/cmdxray",
    "source": "github"
  },
  "websiteUrl": "https://aurelio-nakamura.github.io/cmdxray/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "cmdxray",
      "version": "0.26.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true
        }
      ]
    }
  ]
}
